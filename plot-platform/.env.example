# Copy to .env.local and fill in. Never commit .env.local or any real secret.
# Everything without the NEXT_PUBLIC_ prefix is server-only (Product Contract rule 8).

# --- Supabase ---------------------------------------------------------------
# Local dev: run `npm run db:start` and copy the values it prints.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- AI (Phase 6) -----------------------------------------------------------
# anthropic | openai | gemini
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
EMBEDDING_MODEL=

# --- Maps (Phase 8) ---------------------------------------------------------
# google | mapbox | esri
MAP_TILE_PROVIDER=
MAP_API_KEY=

# --- Storage ----------------------------------------------------------------
STORAGE_BUCKET=project-files

# --- App --------------------------------------------------------------------
# Absolute base URL used for deep links, QR codes and OG images.
PUBLIC_BASE_URL=http://localhost:3000

# --- Billing (Phase 9) ------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Messaging / webhooks (Phase 5+) ----------------------------------------
# none | (future adapters)
WHATSAPP_API_ADAPTER=none
WEBHOOK_SIGNING_SECRET=
