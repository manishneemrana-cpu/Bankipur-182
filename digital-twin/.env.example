# ---- Required by the brief ----
SUPABASE_URL=
SUPABASE_SERVICE_KEY=            # server-only (apps/api). Never ship to a browser.
CUBICASA_API_KEY=                # NOT used yet: provider returns a mock until you confirm (see apps/api/src/floorplan)
ARCHILOGIC_API_KEY=              # NOT used yet: same as above
FLOORPLAN_PROVIDER=mock          # mock | cubicasa | archilogic  (cubicasa/archilogic currently return mock data)

# ---- API server ----
PORT=8787
NODE_ENV=development
ADMIN_API_TOKEN=                 # REQUIRED in production. In dev, a random token is printed at startup if unset.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
PUBLIC_API_URL=http://localhost:8787   # used to build absolute URLs for locally stored files
SUPABASE_STORAGE_BUCKET=project-assets # must be a PUBLIC bucket
# Leave SUPABASE_* empty to run on the local JSON file store + local disk uploads (dev/demo only).

# ---- Frontends (Vite) ----
# apps/viewer/.env and apps/admin/.env
VITE_API_URL=http://localhost:8787
