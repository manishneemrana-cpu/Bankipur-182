# Builds one of the two static apps (viewer | admin) and serves it with nginx.
FROM node:22-slim AS build
ARG APP=viewer
ARG VITE_API_URL
ARG VITE_VIEWER_URL=
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/api/package.json apps/api/
COPY apps/viewer/package.json apps/viewer/
COPY apps/admin/package.json apps/admin/
COPY packages packages
COPY tools/package.json tools/
RUN npm ci --include-workspace-root -w @dt/$APP -w @dt/shared-types
COPY apps/$APP apps/$APP
ENV VITE_API_URL=$VITE_API_URL VITE_VIEWER_URL=$VITE_VIEWER_URL
RUN npm run build -w @dt/$APP

FROM nginx:alpine
ARG APP=viewer
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/$APP/dist /usr/share/nginx/html
