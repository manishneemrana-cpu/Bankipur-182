# Copy to .env.local and fill in. Never commit .env.local or any real secret.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# demo | test | live — see NON-NEGOTIABLE SAFETY RULES. Defaults to demo.
NEXT_PUBLIC_APP_DEFAULT_MODE=demo

# Phase 5+: n8n automation layer (server-only)
N8N_BASE_URL=
N8N_API_KEY=
N8N_WEBHOOK_BASE_URL=
# Shared secret for verifying/signing inbound webhooks at /api/webhooks/n8n
N8N_WEBHOOK_SECRET=

# Phase 3+: AI provider abstraction (server-only)
AI_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Phase 6: SitesNSign read-only connector (server-only). No official API
# is confirmed yet - setting these alone does not enable a live connection,
# see src/lib/sitesnsign/live-connector.ts.
SITESNSIGN_API_URL=
SITESNSIGN_API_KEY=
