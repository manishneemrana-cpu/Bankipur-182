# Copy to .env.local and fill in. Never commit .env.local or any real secret.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# demo | test | live — see NON-NEGOTIABLE SAFETY RULES. Defaults to demo.
NEXT_PUBLIC_APP_DEFAULT_MODE=demo

# Phase 5+: n8n automation layer (server-only)
N8N_BASE_URL=
N8N_API_KEY=
N8N_WEBHOOK_BASE_URL=
# Shared secret for verifying/signing inbound webhooks at /api/webhooks/n8n
N8N_WEBHOOK_SECRET=
# Shared secret n8n sends as x-integration-secret when it calls
# /api/integrations/overdue-followups to pull data (outbound direction,
# separate from N8N_WEBHOOK_SECRET which is for n8n calling us).
N8N_READ_SECRET=

# Phase 3+: AI provider abstraction (server-only)
AI_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Phase 6: SitesNSign Public API (server-only). Confirmed real: OpenAPI 3.0
# doc at https://api.sitesnsign.com/api/docs, auth via x-api-key header.
# SITESNSIGN_API_URL should be the base *without* a trailing /v1, e.g.
# https://api.sitesnsign.com/api - the connector appends /v1/... itself.
# Only ping() is verified against the real spec; other read paths are
# inferred from DTO names and may need correction - see
# src/lib/sitesnsign/live-connector.ts for exactly which.
SITESNSIGN_API_URL=
SITESNSIGN_API_KEY=
