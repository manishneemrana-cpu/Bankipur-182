{
  "name": "SitesNSign - Overdue Follow-up Alerts",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "node-schedule-trigger",
      "name": "Every Hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-680, 0]
    },
    {
      "parameters": {
        "url": "https://sitesnsign-ai-executive.vercel.app/api/integrations/overdue-followups",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-integration-secret",
              "value": "={{ $env.SITESNSIGN_READ_SECRET }}"
            }
          ]
        },
        "options": {}
      },
      "id": "node-http-request",
      "name": "Get Overdue Follow-ups",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-440, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-has-overdue",
              "leftValue": "={{ $json.count }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-if",
      "name": "Any overdue?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-200, 0]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=⚠️ SitesNSign: {{ $json.count }} overdue follow-ups\n\n{{ $json.summary }}",
        "additionalFields": {}
      },
      "id": "node-telegram",
      "name": "Send Telegram Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [40, -120],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "operation": "send",
        "phoneNumberId": "={{ $env.WHATSAPP_PHONE_NUMBER_ID }}",
        "recipientPhoneNumber": "={{ $env.WHATSAPP_ALERT_TO_NUMBER }}",
        "textBody": "=⚠️ SitesNSign: {{ $json.count }} overdue follow-ups\n\n{{ $json.summary }}",
        "additionalFields": {}
      },
      "id": "node-whatsapp",
      "name": "Send WhatsApp Alert",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [40, 120],
      "credentials": {
        "whatsAppApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "WhatsApp Business Cloud"
        }
      }
    }
  ],
  "connections": {
    "Every Hour": {
      "main": [
        [
          {
            "node": "Get Overdue Follow-ups",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Overdue Follow-ups": {
      "main": [
        [
          {
            "node": "Any overdue?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Any overdue?": {
      "main": [
        [
          {
            "node": "Send Telegram Alert",
            "type": "main",
            "index": 0
          },
          {
            "node": "Send WhatsApp Alert",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  }
}
