# Copy this file to .env and fill in real values. NEVER commit .env with real secrets.

# --- App ---
NEXT_PUBLIC_APP_URL=https://www.manishpandey.in
PLATFORM_BRAND_NAME=Magadh Property
NODE_ENV=production

# --- Database (self-hosted Postgres on the VPS, see docs/deployment-vps.md) ---
# POSTGRES_USER/PASSWORD below is the Postgres bootstrap superuser created by
# the `db` container. It is used ONLY to run migrations (MIGRATE_DATABASE_URL) —
# never by the running app. The app connects as APP_DB_USER, an unprivileged
# role with no BYPASSRLS, so tenant-isolation policies actually apply to it.
# `npm run migrate` creates/updates that role automatically. See docs/database.md.
POSTGRES_USER=whatsapp_platform_admin
POSTGRES_PASSWORD=
POSTGRES_DB=whatsapp_platform
MIGRATE_DATABASE_URL=postgres://whatsapp_platform_admin:CHANGE_ME@db:5432/whatsapp_platform

APP_DB_USER=whatsapp_platform_app
APP_DB_PASSWORD=
DATABASE_URL=postgres://whatsapp_platform_app:CHANGE_ME_TOO@db:5432/whatsapp_platform

# --- Redis (job queue / rate limiting, once needed) ---
REDIS_URL=redis://redis:6379

# --- Auth / secrets ---
# 32+ random bytes, base64. Generate with: openssl rand -base64 32
SESSION_SECRET=
# 32-byte key (base64) for AES-256-GCM encryption of stored Meta tokens.
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=1

# --- Meta / WhatsApp Cloud API (leave MOCK_META=true until Phase 5+) ---
# Required only when MOCK_META=false — see src/server/env.ts and docs/meta-current-state.md.
# Never hard-code META_GRAPH_API_VERSION in code; look up the current stable
# version at https://developers.facebook.com/docs/graph-api/changelog before
# setting it here (do not trust a value copied from a blog post or old tutorial).
MOCK_META=true
META_APP_ID=
META_APP_SECRET=
META_BUSINESS_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_APP_SECRET=
META_GRAPH_API_VERSION=
META_EMBEDDED_SIGNUP_CONFIG_ID=
# META_SYSTEM_USER_ID / META_SYSTEM_USER_ACCESS_TOKEN are intentionally NOT
# listed here. Phase 3 research found that a Tech Provider (this platform's
# model) uses per-client "Business Integration System User" tokens obtained
# through Embedded Signup — not one shared system-user token across all
# clients. Those per-organization tokens are stored encrypted in the
# `whatsapp_credentials` table (one row per organization), not in this file.
# See docs/meta-current-state.md and docs/decisions.md.

# --- Billing (Razorpay first) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Observability ---
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
