# Normally written for you by setup.sh. Copy to deploy/.env only if you set things up by hand.

API_DOMAIN=                 # e.g. 203-0-113-7.sslip.io or studio.yourdomain.com
BASIC_USER=admin
BASIC_HASH=''               # bcrypt hash, single-quoted:  docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'

# Safety switch: while false, EVERY paid provider returns mock output (no network call, no cost).
# Set true only after you've put the real keys below. Live today: ElevenLabs TTS and the Mapbox map (needs a PUBLIC pk. token).
# Image-to-video (Luma/Runway/Kling), Google/Azure TTS and Google/Cesium maps are still TODO stubs in the code.
PAID_APIS_ENABLED=false
TTS_PROVIDER=mock           # elevenlabs | google | azure | mock
MAP_PROVIDER=mock           # mapbox | google | cesium | mock
VIDEO_PROVIDER=mock         # luma | runway | kling | mock

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
GOOGLE_TTS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=
CESIUM_ION_TOKEN=
LUMA_API_KEY=
RUNWAY_API_KEY=
KLING_API_KEY=

# Storage/auth: local disk + single account behind the password above (no Supabase needed).
WORKER_CONCURRENCY=2
RENDER_CONCURRENCY=2
