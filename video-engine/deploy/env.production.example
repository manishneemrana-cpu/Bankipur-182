# Copy to deploy/.env on the VPS (chmod 600). Never commit it.

# Public hostname of the API, e.g. api.yourdomain.com. No domain yet? use <vps-ip-with-dashes>.sslip.io (e.g. 203-0-113-7.sslip.io).
API_DOMAIN=

# Your Vercel web-admin origin(s), comma-separated, no trailing slash (CORS allow-list).
WEB_ORIGIN=https://ugc-video-engine-manishneemrana-7172s-projects.vercel.app

# REQUIRED for a public server: without Supabase the API has NO authentication (single shared dev account).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=video-engine

# Safety switch: keep false until you confirm each paid key; providers then return mock output.
PAID_APIS_ENABLED=false
TTS_PROVIDER=mock
MAP_PROVIDER=mock
VIDEO_PROVIDER=mock

WORKER_CONCURRENCY=2
RENDER_CONCURRENCY=2
