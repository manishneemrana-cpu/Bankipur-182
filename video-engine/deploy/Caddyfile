# One public address (automatic HTTPS). The UI + API are behind a password (basic auth).
# /files is public: Remotion's headless browser downloads media from those URLs (paths hold unguessable UUIDs).
{$API_DOMAIN} {
	encode zstd gzip
	handle /files/* {
		reverse_proxy api:4100
	}
	handle {
		basic_auth {
			{$BASIC_USER} {$BASIC_HASH}
		}
		@backend path /api/* /health
		handle @backend {
			reverse_proxy api:4100
		}
		handle {
			reverse_proxy web:3100
		}
	}
}
