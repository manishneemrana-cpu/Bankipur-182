# ─────────────────────────────────────────────────────────────────────────────
# Auto Real-Estate Video Engine — copy to .env (worker/API) and apps/web-admin/.env.local (web)
# Never commit real keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── SAFETY SWITCH ────────────────────────────────────────────────────────────
# While false (default) EVERY paid provider (TTS / map / image-to-video) returns mock output —
# no network call, no cost — even if keys below are filled in. Real calls are TODO stubs until
# you confirm each key is ready (see TODO(paid-api) in apps/worker/src/providers/**).
PAID_APIS_ENABLED=false

# ── Provider selection (can also be changed per account in Settings) ─────────
TTS_PROVIDER=mock            # elevenlabs | google | azure | mock
MAP_PROVIDER=mock            # mapbox | google | cesium | mock
VIDEO_PROVIDER=mock          # luma | runway | kling | mock

# ── Stage 1: Text-to-Speech ──────────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=         # default voice when none chosen in Settings
GOOGLE_TTS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia

# ── Stage 2: Map flyby ───────────────────────────────────────────────────────
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=
CESIUM_ION_TOKEN=
MAP_CAPTURE_SIZE=1440        # square capture px; 1920 = sharper but ~1.8x slower

# ── Stage 3: Image-to-video ──────────────────────────────────────────────────
LUMA_API_KEY=
RUNWAY_API_KEY=
KLING_API_KEY=               # Kling signs JWTs from an access/secret pair; format decided when implemented

# ── Supabase (Postgres + Storage). Leave blank for local JSON-file/disk mode (dev only) ──
SUPABASE_URL=
SUPABASE_SERVICE_KEY=        # service-role key: server only, NEVER ship to the browser
SUPABASE_BUCKET=video-engine

# ── Queue ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── API / worker ─────────────────────────────────────────────────────────────
PORT=4100
PUBLIC_API_URL=http://localhost:4100   # base URL used to build file URLs in local-storage mode
WEB_ORIGIN=http://localhost:3100       # CORS allow-list (comma-separated)
WORKER_CONCURRENCY=2
RENDER_CONCURRENCY=2                   # Chromium tabs per Remotion render
PUPPETEER_EXECUTABLE_PATH=             # optional: full Chromium for map capture — auto-detected otherwise
REMOTION_BROWSER_EXECUTABLE=           # optional: chrome-headless-shell for renders — Remotion downloads its own if blank
DEV_ACCOUNT_ID=00000000-0000-4000-8000-000000000001   # used only when Supabase isn't configured
EMAIL_WEBHOOK_URL=                     # optional: POST {to,subject,text} here to send "video ready" emails (Resend/n8n/etc.)

# ── apps/web-admin/.env.local ────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:4100/api
# NEXT_PUBLIC_SUPABASE_URL=            # enable login; leave blank for single-account dev mode
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
