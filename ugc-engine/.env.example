# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/ugc_engine

# --- Redis / BullMQ ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- LLM (Creative Director agent pipeline) ---
GEMINI_API_KEY=
# Leave empty to run agents against MockLLMProvider (safe for local dev, never used in production)

# --- Video generation providers (Adapter Pattern, provider-agnostic) ---
GOOGLE_VEO_API_KEY=
RUNWAY_API_KEY=
LUMA_API_KEY=
KLING_API_KEY=
DEFAULT_VIDEO_PROVIDER=google-veo-2

# --- Voice / Audio ---
ELEVENLABS_API_KEY=
WHISPER_API_KEY=

# --- Storage (S3-compatible: AWS S3, Cloudflare R2) ---
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# --- White-label ---
DEFAULT_PLATFORM_NAME="Universal AI UGC Creative Engine"
