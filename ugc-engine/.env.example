# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/ugc_engine

# --- Redis / BullMQ ---
# Either REDIS_URL (Upstash-style, redis:// or rediss://) or the discrete vars below.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# =============================================================================
# LLM (Creative Director agent pipeline: brand/audience analysis, hooks,
# script, storyboard). Pick ONE. Leave all empty to run on MockLLMProvider
# (dev only, or set ALLOW_MOCK_PROVIDERS=true to allow it in production too).
# =============================================================================
DEFAULT_LLM_PROVIDER=
# gemini | openrouter | nvidia | groq | together  (leave empty for auto-detect:
# first of these with a key set is used, gemini preferred if its key is present)

# Option A — Google Gemini (also the only provider used for multimodal QC evaluation)
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Option B — OpenRouter (aggregates many models; some are free)
# Get a key: https://openrouter.ai/keys  |  free models: https://openrouter.ai/models?max_price=0
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Option C — NVIDIA NIM (build.nvidia.com), generous free tier
# Get a key: https://build.nvidia.com -> pick a model -> "Get API Key"
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Option D — Groq (very fast inference, generous free tier) — RECOMMENDED FREE DEFAULT
# Get a key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Option E — Together AI (has always-free "Turbo Free" models)
# Get a key: https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo-Free

# =============================================================================
# Speech-to-Text (optional: word-timestamp alignment / transcribing uploads)
# =============================================================================
# Reuses GROQ_API_KEY above if set (whisper-large-v3, free, fast) — RECOMMENDED.
# Or set OPENAI_API_KEY to use real OpenAI's whisper-1 instead.
OPENAI_API_KEY=

# =============================================================================
# Video generation providers (Adapter Pattern, provider-agnostic)
# =============================================================================
# Option A — pollinations-pan: FREE, no key, no signup. Generates a still frame
# per scene via Pollinations.ai and animates it with a Ken Burns pan/zoom in
# Shotstack instead of real motion footage. This is the default — nothing
# below is required to get a real, watchable result.
#
# Option B-E — real AI video models. All are paid/per-second billed; none has
# a free tier that works from the API (Runway/Luma both require purchased
# credits even for a first call).
GOOGLE_VEO_API_KEY=
RUNWAY_API_KEY=
LUMA_API_KEY=
LUMA_MODEL=ray-2
KLING_API_KEY=
DEFAULT_VIDEO_PROVIDER=pollinations-pan

# =============================================================================
# Voice synthesis (TTS)
# =============================================================================
DEFAULT_VOICE_PROVIDER=
# elevenlabs | huggingface  (auto: elevenlabs if its key is set, else huggingface, else mock)

# Option A — ElevenLabs (best quality, includes word-level timing) — RECOMMENDED
# Get a key: https://elevenlabs.io -> Profile -> API Keys  (~10k chars/month free)
ELEVENLABS_API_KEY=

# Option B — Hugging Face Inference API (free, no built-in word timing — estimated instead)
# Get a key: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
HUGGINGFACE_TTS_MODEL=espnet/kan-bayashi_ljspeech_vits

# =============================================================================
# Image generation (thumbnails, reference/concept images — NOT video frames)
# =============================================================================
DEFAULT_IMAGE_PROVIDER=
# pollinations | nvidia | huggingface  (auto: nvidia/huggingface if configured, else pollinations)

# Option A — Pollinations.ai — NO KEY NEEDED, fully free. Used automatically as the fallback.
# Option B — NVIDIA NIM image models (reuses NVIDIA_API_KEY above)
NVIDIA_IMAGE_MODEL=stabilityai/stable-diffusion-xl
# Option C — Hugging Face Inference API (reuses HUGGINGFACE_API_KEY above)
HUGGINGFACE_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# =============================================================================
# Background music
# =============================================================================
# Get a key: https://mubert.com/render . Leave empty to use MockMusicAdapter.
MUBERT_API_KEY=

# =============================================================================
# Storage (S3-compatible: AWS S3, Cloudflare R2)
# =============================================================================
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=

# =============================================================================
# Final video assembly
# =============================================================================
# Get a free key: https://shotstack.io (sign up -> dashboard -> API keys, "Sandbox" key).
# Leave empty to use FFmpegRenderEngine instead (needs the ffmpeg binary + local
# disk — never works on Vercel/serverless, but fine on a VPS/container).
# When set, Shotstack is used automatically: it fetches every scene/voice/music/
# caption asset by URL and renders in the cloud, so no ffmpeg binary is needed —
# but those asset URLs must be real and publicly fetchable (S3/R2 storage, a real
# video/voice provider), not MockStorageAdapter's fake local URLs.
SHOTSTACK_API_KEY=
# "stage" = free sandbox tier (output is watermarked); "v1" = paid production tier.
SHOTSTACK_ENV=stage

# --- Testing / mock mode ---
# Explicit opt-in to run LLM/storage in mock mode even under NODE_ENV=production
# (e.g. a preview deploy with no provider keys configured yet).
ALLOW_MOCK_PROVIDERS=

# --- White-label ---
DEFAULT_PLATFORM_NAME="Universal AI UGC Creative Engine"
